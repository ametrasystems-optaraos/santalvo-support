#!/bin/bash

set -e

if [ "$1" = configure ]; then

	INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')
	ln -f -s /usr/share/santalvosupport/santalvosupport /usr/bin/santalvosupport

	if [ "systemd" == "$INITSYS" ]; then

		if [ -e /etc/systemd/system/santalvosupport.service ]; then
			rm -f /etc/systemd/system/santalvosupport.service /usr/lib/systemd/system/santalvosupport.service /usr/lib/systemd/user/santalvosupport.service >/dev/null  2>&1
		fi
		mkdir -p /usr/lib/systemd/system/
		cp /usr/share/santalvosupport/files/systemd/santalvosupport.service /usr/lib/systemd/system/santalvosupport.service
		# try fix error in Ubuntu 18.04
		# Failed to reload santalvosupport.service: Unit santalvosupport.service is not loaded properly: Exec format error.
		# /usr/lib/systemd/system/santalvosupport.service:10: Executable path is not absolute: pkill -f "santalvosupport --"
		if [ -e /usr/bin/pkill ]; then
			sed -i "s|pkill|/usr/bin/pkill|g" /usr/lib/systemd/system/santalvosupport.service
		fi
		systemctl daemon-reload
		systemctl enable santalvosupport
		systemctl start santalvosupport
	fi
fi
